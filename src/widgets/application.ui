<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name application.ui -->
  <requires lib="gio" version="2.0"/>
  <requires lib="gtk" version="4.21"/>
  <requires lib="libadwaita" version="1.9"/>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="action">win.purge_deleted_tasks</attribute>
        <attribute name="icon">user-trash-full-symbolic</attribute>
        <attribute name="label" translatable="yes">Purge deleted tasks</attribute>
      </item>
    </section>
    <section>
      <attribute name="label">Backup</attribute>
      <item>
        <attribute name="action">win.export_database</attribute>
        <attribute name="icon">document-save-symbolic</attribute>
        <attribute name="label" translatable="yes">Export Tasks…</attribute>
      </item>
      <item>
        <attribute name="action">win.import_database</attribute>
        <attribute name="icon">document-send-symbolic</attribute>
        <attribute name="label" translatable="yes">Import Tasks…</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="action">app.shortcuts</attribute>
        <attribute name="icon">keyboard-symbolic</attribute>
        <attribute name="label" translatable="yes">Keyboard Shortcuts</attribute>
      </item>
      <item>
        <attribute name="action">app.about</attribute>
        <attribute name="label" translatable="yes">About Do It</attribute>
      </item>
    </section>
  </menu>
  <template class="DoItMainWindow" parent="AdwApplicationWindow">
    <child>
      <object class="AdwOverlaySplitView" id="split_view">
        <property name="content">
          <object class="AdwToolbarView">
            <property name="content">
              <object class="AdwToastOverlay" id="toast_overlay">
                <property name="child">
                  <object class="AdwBottomSheet" id="window_bottom_sheet">
                    <property name="bottom-bar">
                      <object class="AdwEntryRow" id="task_new_entry">
                        <property name="enable-emoji-completion">True</property>
                        <property name="show-apply-button">False</property>
                        <property name="title" translatable="yes">Create a new task</property>
                        <child type="suffix">
                          <object class="GtkLabel" id="task_new_entry_hint">
                            <property name="visible">False</property>
                            <style>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="content">
                      <object class="GtkStack" id="list_stack">
                        <property name="transition-type">crossfade</property>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">list_container</property>
                            <property name="child">
                              <object class="AdwClamp">
                                <property name="maximum-size">900</property>
                                <property name="tightening-threshold">600</property>
                                <property name="child">
                                  <object class="AdwPreferencesPage" id="list_container">
                                    <property name="margin-bottom">32</property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">list_empty</property>
                            <property name="child">
                              <object class="AdwStatusPage" id="list_empty">
                                <property name="can-focus">False</property>
                                <property name="description" translatable="yes">Try to add a new task on bottom bar or with Ctrl + N</property>
                                <property name="icon-name">document-new-symbolic</property>
                                <property name="title" translatable="yes">No tasks (yet)</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="sheet">
                      <object class="TaskForm" id="task_form"/>
                    </property>
                  </object>
                </property>
              </object>
            </property>
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-back-button">False</property>
                <property name="title-widget">
                  <object class="AdwWindowTitle">
                    <property name="title">Tasks</property>
                  </object>
                </property>
                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="menu-model">primary_menu</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkMenuButton" id="button_sorting">
                    <property name="icon-name">view-sort-descending-symbolic</property>
                  </object>
                </child>
                <child type="start">
                  <object class="GtkButton" id="button_toggle_sidebar">
                    <property name="action-name">win.toggle-sidebar</property>
                    <property name="icon-name">sidebar-show-symbolic</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child type="start">
                  <object class="GtkButton" id="button_new_task">
                    <property name="icon-name">document-new-symbolic</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <property name="sidebar">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-back-button">False</property>
                <property name="title-widget">
                  <object class="AdwWindowTitle">
                    <property name="title">Projects</property>
                  </object>
                </property>
                <child type="end">
                  <object class="GtkButton" id="button_close_sidebar">
                    <property name="action-name">win.toggle-sidebar</property>
                    <property name="icon-name">sidebar-show-right-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSidebar" id="sidebar_project_list"/>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <!-- Custom object fragments -->
        <condition>max-width: 700sp</condition>
        <setter object="split_view" property="collapsed">True</setter>
        <setter object="split_view" property="show-sidebar">False</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <!-- Custom object fragments -->
        <condition>min-width: 700sp</condition>
        <setter object="button_close_sidebar" property="visible">False</setter>
      </object>
    </child>
  </template>
</interface>
